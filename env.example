PSG_DATA_DIR=/var/lib/pi-sip-gateway
PSG_AST_CONF=/etc/asterisk
PSG_SCRIPTS=/opt/pi-sip-gateway/scripts
PSG_AMI_SECRET=__AMI_SECRET__
PSG_HTTP_BIND=127.0.0.1
PSG_HTTP_PORT=8080
PSG_HTTPS_BIND=0.0.0.0
PSG_HTTPS_PORT=8443
PSG_SSL_CERT=/etc/pi-sip-gateway/cert.pem
PSG_SSL_KEY=/etc/pi-sip-gateway/key.pem
PSG_MOCK=0
